{
  "name": "outlook-fast-mail",
  "version": "1.0.0",
  "description": "Local Outlook IMAP OAuth2 and Microsoft Graph mail receiver.",
  "main": "build/server.cjs",
  "bin": "build/server.cjs",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:server": "node_modules\\.bin\\esbuild.cmd server/index.js --platform=node --format=cjs --target=node18 --outfile=build/server.cjs",
    "build:exe": "npm.cmd run build && npm.cmd run build:server && node_modules\\.bin\\pkg.cmd . --targets node18-win-x64 --output release/OutlookFastMail.exe",
    "start": "node server/index.js",
    "lint": "node --check server/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "axios": "^1.16.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "imapflow": "^1.3.3",
    "lucide-react": "^1.16.0",
    "mailparser": "^3.9.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "vite": "^8.0.13"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [
      "dist/**/*"
    ],
    "outputPath": "release"
  }
}
